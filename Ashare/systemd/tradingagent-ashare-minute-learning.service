[Unit]
Description=Project completed A-share delayed-paper fixture learning evidence
After=tradingagent-ashare-minute-paper.service

[Service]
Type=oneshot
User=tradingagent
Group=tradingagent
WorkingDirectory=/opt/investment/releases/tradingagent/current
Environment=REAL_TRADING_ENABLED=false
Environment=PYTHONPATH=/opt/investment/releases/tradingagent/current
ExecStart=/opt/investment/tools/venvs/tradingagent-observation-py312-pyyaml603-v1/bin/python3 -m Ashare.minute_offline_learning --state-root /var/lib/tradingagent/ashare-minute-paper --learning-root /var/lib/tradingagent/ashare-minute-learning
UMask=0077
StateDirectory=tradingagent/ashare-minute-learning
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/investment/releases/tradingagent
ReadOnlyPaths=/var/lib/tradingagent/ashare-minute-paper
ReadWritePaths=/var/lib/tradingagent/ashare-minute-learning
StandardOutput=journal
StandardError=journal
