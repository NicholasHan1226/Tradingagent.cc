[Unit]
Description=Fail closed by stopping only the isolated A-share scale-500 units

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl disable --now tradingagent-ashare-minute-scale500-session.timer tradingagent-ashare-minute-scale500-paper.timer
ExecStart=/usr/bin/systemctl stop tradingagent-ashare-minute-scale500-session.service tradingagent-ashare-minute-scale500-paper.service
StandardOutput=journal
StandardError=journal
