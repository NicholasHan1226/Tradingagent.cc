# Secret-free scale-500 delayed-paper configuration. The bearer token remains
# in the separately provisioned 0600 token file and is never copied here.
REAL_TRADING_ENABLED=false
ASHARE_MINUTE_SCALE500_STATE_ROOT=/var/lib/tradingagent/ashare-minute-paper-scale500
ASHARE_MINUTE_ROLLBACK30_STATE_ROOT=/var/lib/tradingagent/ashare-minute-paper
ASHARE_MINUTE_SCALE500_UNIVERSE_SOURCE=/etc/tradingagent/ashare-minute-universe-scale500.json
ASHARE_MINUTE_SCALE500_UNIVERSE_SHA256=2894024d2dad1a42d3891e7ebb66dcc55475724c2a8a3d454f25d98d63588814
ASHARE_MINUTE_SCALE500_CANARY_RECEIPT=/var/lib/tradingagent/ashare-minute-paper-scale500/current-canary-receipt.json
# 500-symbol rt_min queries exceed the default 20s budget on the growing
# TradingDatas read model; give the isolated scale-500 session 60s.
ASHARE_MINUTE_SESSION_TIMEOUT_SECONDS=60
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
