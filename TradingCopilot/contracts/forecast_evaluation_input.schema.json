{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tradingagent.trading_copilot_forecast_evaluation_input.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractId", "generatedAt", "horizon", "roundTripCostBps", "samples"],
  "properties": {
    "contractId": { "const": "tradingagent.trading_copilot_forecast_evaluation_input.v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "horizon": { "type": "string", "minLength": 1 },
    "roundTripCostBps": { "type": "number", "minimum": 0, "maximum": 500 },
    "samples": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["sampleId", "symbol", "decisionTime", "labelTime", "actualReturn", "sourceReceiptId", "sourceReceiptSha256", "predictions"],
        "properties": {
          "sampleId": { "type": "string", "minLength": 1 }, "symbol": { "type": "string", "minLength": 1 },
          "decisionTime": { "type": "string", "format": "date-time" }, "labelTime": { "type": "string", "format": "date-time" },
          "actualReturn": { "type": "number" }, "sourceReceiptId": { "type": "string", "minLength": 1 },
          "sourceReceiptSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "predictions": {
            "type": "object", "minProperties": 2,
            "required": ["naive_last_value", "linear_ridge_baseline"],
            "additionalProperties": {
              "type": "object", "additionalProperties": false, "required": ["pointReturn"],
              "properties": { "pointReturn": { "type": "number" }, "lowerReturn": { "type": ["number", "null"] }, "upperReturn": { "type": ["number", "null"] } }
            }
          }
        }
      }
    }
  }
}
