[Unit]
Description=TradingAgent Crypto detached delayed-paper learning full scrub candidate
AssertPathExists=/opt/investment/tools/venvs/tradingagent-observation-py312-pyyaml603-v1/bin/python3
AssertPathExists=/opt/investment/releases/tradingagent/current/Crypto/delayed_paper_learning_worker.py

[Service]
Type=oneshot
User=tradingagent
Group=tradingagent
WorkingDirectory=/opt/investment/releases/tradingagent/current
Environment=REAL_TRADING_ENABLED=false
Environment=PYTHONPATH=/opt/investment/releases/tradingagent/current
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/investment/tools/venvs/tradingagent-observation-py312-pyyaml603-v1/bin/python3 -m Crypto.delayed_paper_learning_worker --mode full-scrub --output-root /var/lib/tradingagent/crypto-delayed-paper
TimeoutStartSec=300s
TimeoutStopSec=15s
UMask=0077
StateDirectory=tradingagent/crypto-delayed-paper
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ReadOnlyPaths=/opt/investment/releases/tradingagent
ReadOnlyPaths=/opt/investment/tools/venvs/tradingagent-observation-py312-pyyaml603-v1
ReadWritePaths=/var/lib/tradingagent/crypto-delayed-paper
StandardOutput=journal
StandardError=journal
