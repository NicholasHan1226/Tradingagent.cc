[Unit]
Description=TradingAgent Crypto detached delayed-paper learning full scrub candidate
AssertPathExists=/opt/investment/tools/venvs/tradingagent-observation-py312-pyyaml603-v1/bin/python3
AssertPathExists=/opt/investment/releases/tradingagent/current/Crypto/delayed_paper_learning_worker.py
AssertPathExists=/etc/tradingagent/crypto-delayed-paper.epoch.json
AssertPathExists=/var/lib/tradingagent/crypto-delayed-paper-epochs/.current_epoch.json
AssertPathExists=/var/lib/tradingagent/crypto-delayed-paper-epochs/.current_epoch.lock
AssertPathExists=/var/lib/tradingagent/crypto-delayed-paper-epochs/crypto-delayed-paper-epoch-g2-20260729/.epoch_identity.json
AssertPathExists=/var/lib/tradingagent/crypto-delayed-paper-epochs/crypto-delayed-paper-epoch-g2-20260729/evolution

[Service]
Type=oneshot
User=tradingagent
Group=tradingagent
WorkingDirectory=/opt/investment/releases/tradingagent/current
Environment=REAL_TRADING_ENABLED=false
Environment=PYTHONPATH=/opt/investment/releases/tradingagent/current
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/investment/tools/venvs/tradingagent-observation-py312-pyyaml603-v1/bin/python3 -m Crypto.delayed_paper_learning_worker --mode full-scrub --epoch-manifest /etc/tradingagent/crypto-delayed-paper.epoch.json
TimeoutStartSec=300s
TimeoutStopSec=15s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ReadOnlyPaths=/opt/investment/releases/tradingagent
ReadOnlyPaths=/opt/investment/tools/venvs/tradingagent-observation-py312-pyyaml603-v1
ReadOnlyPaths=/etc/tradingagent/crypto-delayed-paper.epoch.json
ReadOnlyPaths=/var/lib/tradingagent/crypto-delayed-paper-epochs
ReadWritePaths=/var/lib/tradingagent/crypto-delayed-paper-epochs/crypto-delayed-paper-epoch-g2-20260729/evolution
StandardOutput=journal
StandardError=journal
