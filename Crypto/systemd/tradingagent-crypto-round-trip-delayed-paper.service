[Unit]
Description=TradingAgent Crypto round-trip closed-5m simulated accumulator
Wants=network-online.target
After=network-online.target
AssertPathExists=/etc/tradingagent/crypto-delayed-paper.runtime.json
AssertPathExists=/etc/tradingagent/crypto-delayed-paper-round-trip.env
AssertPathExists=/run/secrets/tradingagent/tradingdatas-crypto-read.token
AssertPathExists=/opt/investment/releases/tradingagent/current/Crypto/delayed_paper_round_trip_runtime.py

[Service]
Type=oneshot
User=tradingagent
Group=tradingagent
WorkingDirectory=/opt/investment/releases/tradingagent/current
Environment=REAL_TRADING_ENABLED=false
Environment=PYTHONPATH=/opt/investment/releases/tradingagent/current
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/tradingagent/crypto-delayed-paper-round-trip.env
ExecStart=/opt/investment/tools/venvs/tradingagent-observation-py312-pyyaml603-v1/bin/python3 -m Crypto.delayed_paper_round_trip_runtime --epoch-manifest ${ROUND_TRIP_EPOCH_MANIFEST} --runtime-manifest /etc/tradingagent/crypto-delayed-paper.runtime.json --token-file /run/secrets/tradingagent/tradingdatas-crypto-read.token
TimeoutStartSec=180s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/investment/releases/tradingagent
ReadOnlyPaths=/etc/tradingagent/crypto-delayed-paper.runtime.json
ReadOnlyPaths=/etc/tradingagent/crypto-delayed-paper-round-trip.env
ReadOnlyPaths=/etc/tradingagent/crypto-delayed-paper-round-trip-epochs
ReadOnlyPaths=/run/secrets/tradingagent/tradingdatas-crypto-read.token
ReadOnlyPaths=/var/lib/tradingagent/crypto-delayed-paper-epochs/crypto-delayed-paper-epoch-g2-20260729
ReadWritePaths=/var/lib/tradingagent/crypto-delayed-paper-epochs
StandardOutput=journal
StandardError=journal
