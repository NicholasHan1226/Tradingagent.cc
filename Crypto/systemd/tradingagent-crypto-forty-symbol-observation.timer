[Unit]
Description=TradingAgent Crypto forty-symbol closed-5m observation accumulator timer

[Timer]
# Run at close +285s, after the forty-symbol +270s receipt settle boundary.
OnCalendar=*-*-* *:4/5:45
AccuracySec=1s
RandomizedDelaySec=3s
Persistent=false
Unit=tradingagent-crypto-forty-symbol-observation.service

[Install]
WantedBy=timers.target
