[Unit]
Description=TradingAgent Crypto detached ten-symbol factor-research full scrub candidate
AssertPathExists=/opt/investment/tools/venvs/tradingagent-observation-py312-pyyaml603-v1/bin/python3
AssertPathExists=/opt/investment/releases/tradingagent/current/Crypto/ten_symbol_factor_research_worker.py
AssertPathExists=/etc/tradingagent/crypto-ten-symbol-observation.runtime.json
AssertPathExists=/var/lib/tradingagent/crypto-ten-symbol-observation
AssertPathExists=/var/lib/tradingagent/crypto-ten-symbol-observation/evolution/ten_symbol_factor_research

[Service]
Type=oneshot
User=tradingagent
Group=tradingagent
WorkingDirectory=/opt/investment/releases/tradingagent/current
Environment=REAL_TRADING_ENABLED=false
Environment=PYTHONPATH=/opt/investment/releases/tradingagent/current
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/investment/tools/venvs/tradingagent-observation-py312-pyyaml603-v1/bin/python3 -m Crypto.ten_symbol_factor_research_worker --mode full-scrub
TimeoutStartSec=300s
TimeoutStopSec=15s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ReadOnlyPaths=/opt/investment/releases/tradingagent
ReadOnlyPaths=/opt/investment/tools/venvs/tradingagent-observation-py312-pyyaml603-v1
ReadOnlyPaths=/etc/tradingagent/crypto-ten-symbol-observation.runtime.json
ReadOnlyPaths=/var/lib/tradingagent/crypto-ten-symbol-observation
ReadWritePaths=/var/lib/tradingagent/crypto-ten-symbol-observation/evolution/ten_symbol_factor_research
StandardOutput=journal
StandardError=journal
