{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradingagent.cc/schemas/fill_card_schema.json",
  "title": "Tradings Fill Card",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "order_id",
    "status",
    "filled_price",
    "filled_qty",
    "slippage",
    "fee",
    "executed_at",
    "account_type",
    "capital_layer",
    "idempotency_key"
  ],
  "properties": {
    "order_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "status": {
      "type": "string",
      "const": "filled"
    },
    "filled_price": {
      "type": "number"
    },
    "filled_qty": {
      "type": "integer",
      "minimum": 0
    },
    "filled_quantity": {
      "type": "integer",
      "minimum": 0
    },
    "slippage": {
      "type": "number"
    },
    "fee": {
      "type": "number",
      "minimum": 0
    },
    "executed_at": {
      "type": "string",
      "format": "date-time"
    },
    "account_type": {
      "type": "string",
      "enum": ["real", "simulated"]
    },
    "capital_layer": {
      "type": "string",
      "enum": ["real", "simulated"]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    }
  }
}
