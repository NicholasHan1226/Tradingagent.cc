{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradingagent.cc/schemas/signal_card_schema.json",
  "title": "Tradings Signal Card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id",
    "ts_code",
    "direction",
    "quantity",
    "price",
    "stop_loss",
    "strategy_name",
    "timestamp",
    "status",
    "capital_layer",
    "account_type",
    "manual_confirm_required",
    "direct_execution",
    "trigger",
    "evidence_refs",
    "valid_until",
    "risk_check",
    "source_condition_id",
    "idempotency_key",
    "t_plus_1"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "capital_layer": {
            "const": "real"
          }
        },
        "required": ["capital_layer"]
      },
      "then": {
        "properties": {
          "manual_confirm_required": {
            "const": true
          },
          "direct_execution": {
            "const": false
          }
        }
      }
    }
  ],
  "properties": {
    "order_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "ts_code": {
      "type": "string",
      "minLength": 1
    },
    "direction": {
      "type": "string",
      "enum": ["buy", "sell"]
    },
    "quantity": {
      "type": "integer",
      "minimum": 1
    },
    "price": {
      "type": ["number", "null"]
    },
    "stop_loss": {
      "type": ["number", "null"]
    },
    "strategy_name": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "claimed", "running", "filled", "expired", "cancelled", "failed", "partial"]
    },
    "capital_layer": {
      "type": "string",
      "enum": ["real", "simulated", "shadow"]
    },
    "account_type": {
      "type": "string",
      "enum": ["real", "simulated", "none"]
    },
    "manual_confirm_required": {
      "type": "boolean"
    },
    "direct_execution": {
      "type": "boolean"
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition_id", "triggered_at", "trigger_price"],
      "properties": {
        "condition_id": {
          "type": "string"
        },
        "triggered_at": {
          "type": "string",
          "format": "date-time"
        },
        "trigger_price": {
          "type": ["number", "null"]
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "valid_until": {
      "type": "string",
      "format": "date"
    },
    "risk_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "checks"],
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "source_condition_id": {
      "type": "string"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "t_plus_1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sellable_from", "sellable_date"],
      "properties": {
        "sellable_from": {
          "type": "string",
          "format": "date"
        },
        "sellable_date": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}
