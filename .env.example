# =============================================================================
# TradingAgent .env.example
# Copy to .env and fill in your values.
# =============================================================================

# ---- Core Paths ----
# Path to the MarketGraph .env file (for loading shared env vars)
MARKETGRAPH_ENV_FILE=/opt/investment/MarketGraph/.env

# ---- MarketGraph Integration ----
# MarketGraph project root (used by tradingagentDataReader for CSV data)
MARKETGRAPH_ROOT=/opt/investment/MarketGraph

# ---- SharedSignals Database ----
# SQLite read-model database path
SHARED_SIGNALS_DB=/opt/investment/MarketGraphRuntime/read_model/marketdata.sqlite

# SharedSignals root directory
SHAREDSIGNALS_ROOT=/opt/investment/MarketGraphRuntime

# ---- AI / LLM ----
# DeepSeek API key (used by bull_bear_debate, strategy agents, etc.)
# Falls back to DEEPSEEK_API_KEY if TRADINGS_DEEPSEEK_API_KEY is not set
TRADINGS_DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY=

# ---- Email ----
# Cloudflare email routing (primary)
CLOUDFLARE_EMAIL_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_FROM=notice@agentspaces.cc

# Trading notification recipients
# Precedence: TRADINGS_EMAIL_RECIPIENT > TRADINGS_DAILY_RECIPIENT > CHANNELS["trading"]["to"]
TRADINGS_EMAIL_RECIPIENT=
TRADINGS_DAILY_RECIPIENT=

# ---- Alert / Self-Heal ----
# No additional env vars needed — alert routing uses SELF_HEAL_WINDOWS in code
