# =============================================================================
# TradingAgent .env.example
# Copy to .env and fill in your values.
# =============================================================================

# ---- Core Paths ----
# Shared finance env file for common non-secret routing defaults.
FINANCE_SHARED_ENV_FILE=/opt/tradingagent/.env

# ---- MarketGraph Integration ----
# ---- TradingDatas V1 API ----
# All authority-routing values are explicit and intentionally blank here.
# Missing values keep the V1 consumer unavailable; never infer localhost,
# catalog versions, access policy IDs or provider-specific dataset IDs.
TRADINGDATAS_API_URL=
TRADINGDATAS_CATALOG_VERSION=
# TradingAgent-local cache/audit namespace for the future injected transport
# identity. It is not a TradingDatas HTTP header and is not a credential.
TRADINGDATAS_ACCESS_POLICY_ID=
TRADINGDATAS_MARKET_PULSE_DATASET_IDS_JSON=
TRADINGDATAS_SCHEMA_MAJOR=
TRADINGDATAS_RUNTIME_TRANSPORT=
# TradingDatas authentication is intentionally absent until a fresh handoff
# freezes the actual service-token/header contract. Do not invent an API-key
# variable or reuse any legacy SharedSignals credential.
TRADINGDATAS_API_TIMEOUT=10

# ---- Evidence-only AI / LLM sidecar ----
# DeepSeek has a strict, default-disabled HTTP transport candidate plus frozen
# offline fixtures. The only historical real request reached the provider but
# failed the local evidence schema, so it produced no accepted evidence and is
# not reusable acceptance proof. Network use still needs separate authorization,
# a rotated credential and the full evidence Gateway/Journal path. Never paste,
# log or commit a key; rotate any credential exposed in chat before injection.
TRADINGAGENT_LLM_PROVIDER=deepseek
TRADINGAGENT_LLM_BASE_URL=https://api.deepseek.com
TRADINGAGENT_LLM_API_KEY_ENV=DEEPSEEK_API_KEY
TRADINGAGENT_LLM_FLASH_MODEL=deepseek-v4-flash
TRADINGAGENT_LLM_PRO_MODEL=deepseek-v4-pro
TRADINGAGENT_LLM_NETWORK_ENABLED=false
DEEPSEEK_API_KEY=

# ---- Email ----
# Cloudflare email routing (primary)
CLOUDFLARE_EMAIL_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_FROM=notice@tradingagent.cc

# Trading notification recipients
# Precedence: TRADINGS_EMAIL_RECIPIENT > TRADINGS_DAILY_RECIPIENT > CHANNELS["trading"]["to"]
TRADINGS_EMAIL_RECIPIENT=
TRADINGS_DAILY_RECIPIENT=

# ---- Alert / Self-Heal ----
# No additional env vars needed — alert routing uses SELF_HEAL_WINDOWS in code
