[Unit]
Description=TradingAgent A-share delayed five-minute paper timer

[Timer]
OnCalendar=Mon..Fri *-*-* 09:40/5:40
OnCalendar=Mon..Fri *-*-* 10:00/5:40
OnCalendar=Mon..Fri *-*-* 11:00..35/5:40
OnCalendar=Mon..Fri *-*-* 13:10/5:40
OnCalendar=Mon..Fri *-*-* 14:00/5:40
OnCalendar=Mon..Fri *-*-* 15:00:40
OnCalendar=Mon..Fri *-*-* 15:05:40
AccuracySec=1s
RandomizedDelaySec=10s
Persistent=false
Unit=tradingagent-ashare-minute-paper.service

[Install]
WantedBy=timers.target
