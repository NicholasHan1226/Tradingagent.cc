[Unit]
Description=Prepare TradingAgent A-share delayed-paper minute session
Wants=network-online.target
After=network-online.target tradingdatas-v1-internal.service
ConditionPathExists=/etc/tradingagent/ashare-minute-paper.env
ConditionPathExists=/run/secrets/tradingagent/tradingdatas-read.token
ConditionPathExists=/opt/investment/tools/venvs/tradingagent-observation-py312-pyyaml603-v1/bin/python3
ConditionPathExists=/opt/investment/releases/tradingagent/current/Ashare/minute_session_initializer.py

[Service]
Type=oneshot
User=tradingagent
Group=tradingagent
WorkingDirectory=/opt/investment/releases/tradingagent/current
EnvironmentFile=/etc/tradingagent/ashare-minute-paper.env
Environment=REAL_TRADING_ENABLED=false
Environment=PYTHONPATH=/opt/investment/releases/tradingagent/current
ExecStart=/opt/investment/tools/venvs/tradingagent-observation-py312-pyyaml603-v1/bin/python3 -m Ashare.minute_session_initializer --state-root ${ASHARE_MINUTE_PAPER_STATE_ROOT} --token-file /run/secrets/tradingagent/tradingdatas-read.token
TimeoutStartSec=90s
UMask=0077
StateDirectory=tradingagent/ashare-minute-paper
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
ReadOnlyPaths=/opt/investment/releases/tradingagent
ReadOnlyPaths=/opt/investment/tools/venvs/tradingagent-observation-py312-pyyaml603-v1
ReadOnlyPaths=/etc/tradingagent
ReadOnlyPaths=/run/secrets/tradingagent
ReadWritePaths=/var/lib/tradingagent/ashare-minute-paper
StandardOutput=journal
StandardError=journal
