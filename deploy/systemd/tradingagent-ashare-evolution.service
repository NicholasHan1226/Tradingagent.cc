[Unit]
Description=TradingAgent A-share sample-ops evolution decision and evidence-gated automatic Champion promotion (simulation only)
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/tradingagent/ashare-evolution.env
ConditionPathExists=/opt/investment/tools/venvs/tradingagent-observation-py312-pyyaml603-v1/bin/python3
ConditionPathExists=/opt/investment/releases/tradingagent/current/shared/runtime_test/ashare_sample_ops.py

[Service]
Type=oneshot
User=tradingagent
Group=tradingagent
WorkingDirectory=/opt/investment/releases/tradingagent/current
EnvironmentFile=/etc/tradingagent/ashare-evolution.env
Environment=REAL_TRADING_ENABLED=false
Environment=MARKETGRAPH_MODE=mg_off
Environment=PYTHONPATH=/opt/investment/releases/tradingagent/current
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/sh -c 'exec /opt/investment/tools/venvs/tradingagent-observation-py312-pyyaml603-v1/bin/python3 -m shared.runtime_test.ashare_sample_ops --journal-path ${ASHARE_SAMPLE_JOURNAL_PATH} --review-dir ${ASHARE_REVIEW_DIR} --validation-plan-path ${ASHARE_VALIDATION_PLAN_ARTIFACT} --trade-date "$(date +%%Y%%m%%d)" --as-of "$(date -Iseconds)"'
TimeoutStartSec=30min
UMask=0077
StateDirectory=tradingagent/ashare-evolution
StateDirectoryMode=0700
LogsDirectory=tradingagent/ashare-evolution
LogsDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
ReadOnlyPaths=/opt/investment/releases/tradingagent
ReadOnlyPaths=/opt/investment/tools/venvs/tradingagent-observation-py312-pyyaml603-v1
ReadOnlyPaths=/etc/tradingagent
ReadWritePaths=/var/lib/tradingagent/ashare-evolution
ReadWritePaths=/var/log/tradingagent/ashare-evolution
StandardOutput=append:/var/log/tradingagent/ashare-evolution/evolution.log
StandardError=append:/var/log/tradingagent/ashare-evolution/evolution.log
