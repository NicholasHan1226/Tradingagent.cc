# Secret-free internal observation configuration. Copy outside the release tree
# only after installation preflight; never place token content here.
REAL_TRADING_ENABLED=false
MARKETGRAPH_MODE=mg_off
TRADINGDATAS_API_URL=http://127.0.0.1:18082
TRADINGDATAS_ACCESS_POLICY_ID=ta-ashare-observation-read-v1
ASHARE_OBSERVATION_MANIFEST_ROOT=/var/lib/tradingagent/ashare-observation/manifests
ASHARE_OBSERVATION_MANIFEST=/var/lib/tradingagent/ashare-observation/manifests/current.json
ASHARE_OBSERVATION_STATE_ROOT=/var/lib/tradingagent/ashare-observation
ASHARE_OBSERVATION_RUNTIME_ROOT=/run/tradingagent/ashare-observation
ASHARE_OBSERVATION_LOG_ROOT=/var/log/tradingagent/ashare-observation
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
