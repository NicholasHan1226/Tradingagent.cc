# Secret-free evolution/promotion runtime configuration. Simulation-only:
# evidence-ready decisions execute automatic Champion promotion into the
# simulation-only registry under ASHARE_REVIEW_DIR/champion_registry without a
# human gate; real trading, live transition and automatic risk expansion stay
# permanently disabled.
REAL_TRADING_ENABLED=false
ASHARE_SAMPLE_JOURNAL_PATH=/var/lib/tradingagent/ashare-evolution/sample_journal.jsonl
ASHARE_REVIEW_DIR=/var/lib/tradingagent/ashare-evolution/review
ASHARE_VALIDATION_PLAN_ARTIFACT=/etc/tradingagent/ashare-validation-plan.json
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
